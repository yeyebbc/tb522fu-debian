#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Locate and validate the installed root. All other partitions remain read-only.
set -eu
export PATH=/bin:/sbin
[ "$(readlink /proc/1/exe)" = /bin/busybox ]
[ -s "/lib/modules/$(uname -r)/modules.dep" ]
modprobe -v phy_qcom_qmp_ufs
modprobe -v ufs_qcom
complete=
for attempt in $(seq 1 60); do
    mdev -s
    disks=0
    for node in /sys/class/block/*; do
        [ -e "$node" ] || continue
        dev="/dev/${node##*/}"
        [ -b "$dev" ]
        blockdev --setro "$dev"
        [ "$(blockdev --getro "$dev")" = 1 ]
        case "${node##*/}" in loop[0-9]*) continue;; sd*) ;; *) exit 1;; esac
        [ ! -e "$node/partition" ] || continue
        case "$(readlink -f "$node/device")" in */1d84000.ufs/*) ;; *) exit 1;; esac
        disks=$((disks + 1))
    done
    [ "$disks" -le 6 ]
    if [ "$disks" = 6 ]; then complete=1; break; fi
    sleep 1
done
[ "$complete" = 1 ]
touch /run/storage-readonly-verified
root=
for node in /sys/class/block/sd*; do
    [ -f "$node/partition" ] || continue
    grep -qx 'PARTNAME=debian' "$node/uevent" || continue
    [ -z "$root" ] || { echo 'Duplicate Debian partition'; exit 1; }
    root="$node"
done
# The bounded profile also serves as a maintenance environment before install.
[ -n "$root" ] || { echo 'No Debian partition; maintenance only'; exit 2; }
parent=$(dirname "$(readlink -f "$root")")
case "$(readlink -f "$parent/device")" in */1d84000.ufs/*:0:0:0) ;; *) exit 1;; esac
[ "$(cat "$parent/queue/logical_block_size")" = 4096 ]
[ "$(cat "$root/start")" = 454096896 ]
[ "$(cat "$root/partition")" = 17 ]
size=$(cat "$root/size")
# Two explicit layouts only: original 256 GiB, or 244 GiB + 12 GiB swap.
case "$size" in 536870912|511705088) ;; *) exit 1;; esac
partuuid=$(sed -n 's/^PARTUUID=//p' "$root/uevent")
[ "${#partuuid}" = 36 ]
dev="/dev/${root##*/}"
disk="/dev/${parent##*/}"
environment=debian
if [ -e /etc/root-environment ]; then
    environment=$(cat /etc/root-environment)
fi
swap=
for node in /sys/class/block/sd*; do
    [ -f "$node/partition" ] || continue
    grep -qx 'PARTNAME=debian-swap' "$node/uevent" || continue
    [ -z "$swap" ] || { echo 'Duplicate Debian swap partition'; exit 1; }
    swap="$node"
done
if [ "$size" = 511705088 ]; then
    [ -n "$swap" ]
    [ "$(dirname "$(readlink -f "$swap")")" = "$parent" ]
    [ "$(cat "$swap/start")" = 965801984 ]
    [ "$(cat "$swap/size")" = 25165824 ]
    [ "$(cat "$swap/partition")" = 18 ]
    # No mount or fsck may precede this header inspection / resume attempt.
    # Bounded test/maintenance kernels never restore an installed-kernel image.
    resume_mode=inspect
    [ "$(cat /etc/boot-profile)" != installed ] || resume_mode=resume
    touch /run/hibernation-guard-pending
    /sbin/tb522fu-resume "$resume_mode" "/dev/${swap##*/}" "$disk"
    rm /run/hibernation-guard-pending
else
    [ -z "$swap" ]
fi
if [ "$environment" = maintenance ]; then
    [ "$(cat /etc/boot-profile)" = disk-test ]
    echo 'Explicit read-only maintenance: no root mount or filesystem check'
    exit 2
fi
mkdir -p /newroot
target=/newroot
case "$environment" in
    debian) ;;
    ubuntu-test)
        [ "$(cat /etc/boot-profile)" = disk-test ]
        relative=var/lib/tb522fu-dualboot/ubuntu-26.04.1-test/root
        store=/run/tb522fu-ubuntu-store
        target=/newroot/$relative
        ;;
    fedora45-test)
        [ "$(cat /etc/boot-profile)" = disk-test ]
        relative=var/lib/tb522fu-dualboot/fedora45-test/root
        store=/run/tb522fu-fedora45-store
        target=/newroot/$relative
        ;;
    *) exit 1;;
esac
# noload prevents even journal replay before identity checks complete.
if ! mount -t ext4 -o ro,noload "$dev" /newroot; then
    rmdir /newroot
    # A newly created partition has no filesystem yet. The bounded profile
    # must expose its read-only maintenance channel so installation can proceed.
    # Never format here, and never relax root verification for production.
    if [ "$(cat /etc/boot-profile)" = disk-test ]; then
        echo 'Debian root is not mountable; read-only maintenance only'
        exit 2
    fi
    exit 1
fi
[ "$(cat /newroot/etc/tb522fu/board)" = lenovo-tb522fu ]
[ "$(cat /newroot/etc/tb522fu/root-partuuid)" = "$partuuid" ]
if [ "$environment" != debian ]; then
    # Only an explicitly staged trial root may be selected. No path or mode
    # comes from a writable marker, boot argument or automatic discovery.
    [ "$(readlink -f "$target")" = "$target" ]
    [ "$(cat "$target/etc/tb522fu/board")" = lenovo-tb522fu ]
    [ "$(cat "$target/etc/tb522fu/root-partuuid")" = "$partuuid" ]
    [ "$(cat "$target/etc/tb522fu/root-environment")" = "$environment" ]
    case "$environment" in
        ubuntu-test)
            [ "$(cat "$target/etc/tb522fu/ubuntu-trial-iso-sha256")" = c54d196489d3c867975fb3bbb72ca52ec2e137456e305481f81096304e4d2517 ]
            grep -qx 'ID=ubuntu' "$target/etc/os-release"
            grep -qx 'VERSION_ID="26.04"' "$target/etc/os-release"
            ;;
        fedora45-test)
            [ "$(cat "$target/etc/tb522fu/fedora45-trial-image-sha256")" = 07ab3377cee9d4bbc15e7203214594f8cfdb58a9a57e195aa0ff183cf81ea0a8 ]
            grep -qx 'ID=fedora' "$target/etc/os-release"
            grep -qx 'VERSION_ID=45' "$target/etc/os-release"
            ;;
        *) exit 1;;
    esac
fi
[ -x "$target/sbin/init" ]
[ -s "$target/usr/lib/modules/$(uname -r)/modules.dep" ]
umount /newroot
blockdev --setrw "$disk"
blockdev --setrw "$dev"
[ "$(blockdev --getro "$dev")" = 0 ]
status=0
/sbin/e2fsck -p "$dev" || status=$?
# e2fsck: 0=clean, 1=corrected. Any other result requires intervention.
[ "$status" -le 1 ]
if [ "$environment" != debian ]; then
    # /run is moved into the new root by disk-init. Keep the backing mount
    # there so switch_root cannot delete it along with the old initramfs.
    mkdir "$store"
    mount -t ext4 -o rw "$dev" "$store"
    touch "${store}-mounted"
    mount -o bind "$store/$relative" /newroot
else
    mount -t ext4 -o rw "$dev" /newroot
fi
printf '%s\n' "$partuuid" >/run/disk-root-verified
echo "TB522FU_DISK_ROOT_READY: checked $environment ext4 root, other partitions read-only"
