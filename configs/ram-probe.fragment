CONFIG_Y900_ACM_DIAG_DTB=y
CONFIG_LOCALVERSION="-tb522fu-probe01"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_FORCE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
# The initramfs has no modules: the USB2 reference-clock provider must be built in.
CONFIG_SM_TCSRCC_8750=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_PINCTRL_SM8750=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_MAGIC_SYSRQ=y
CONFIG_NULL_TTY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CMDLINE="rdinit=/init panic=5 oops=panic softlockup_panic=1 hung_task_panic=1 console=tty0 loglevel=7 fbcon=font:TER16x32 clk_ignore_unused pd_ignore_unused qcom_scm.download_mode=off qcom_scm.probe_edl_return=1 qcom_scm.probe_seconds=600 modprobe.blacklist=lenovo_yoga_keyboard"
CONFIG_CMDLINE_FORCE=y
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_DEBUG_FS=y

# Keep the diagnostic build specific to Qualcomm; retain the clean reference.
CONFIG_ARCH_QCOM=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# RAM desktop uses only the firmware scanout; native display/GPU stay disabled.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MSM=m
CONFIG_SM_DISPCC_8750=m
CONFIG_DRM_PANEL_NOVATEK_NT36536=m
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_INPUT_EVDEV=y
CONFIG_SPI_QCOM_GENI=m
CONFIG_TOUCHSCREEN_NT36536_SPI=m
# CONFIG_TOUCHSCREEN_NOVATEK_NT36XXX is not set

# Stock SE4 is GPI-only; explicitly load gpi before spi_geni_qcom.
CONFIG_QCOM_GPI_DMA=m

# UFS is staged manually after the isolated USB recovery path is ready.
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_QMP_UFS=m

# The first accessory test loads its driver manually after USB/return checks.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT_LENOVO_YOGA_KEYBOARD=m

# This Android RTC exposes a raw counter without a verified Unix-time offset.
# Its late probe overwrote fake-hwclock's restored date with 1970 on CI15.
# Keep the RTC available for investigation, but use Debian's saved clock until
# its stock offset format is understood. Never write Android's RTC from NTP.
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set

# CI20 verified explicit ADSP startup; test normal coldplug with bounded return.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_BATTERY_QCOM_BATTMGR=m
