From 358cc938acc22c0e05fe5c0fa75ee1c5b7917825 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 14 Nov 2026 06:45:51 +0800
Subject: [PATCH 190/194] dt-bindings: media: Describe OV02B10 CSI2 sensor

Describe the sensor clock, reset, two supplies and single CSI2 data lane.
The example uses the supported 24 MHz/330 MHz RAW10 mode. This is a local
bring-up binding; its placeholder maintainer must be replaced before any
upstream submission.

Signed-off-by: Codex <codex@localhost>
---
 .../bindings/media/i2c/ovti,ov02b10.yaml      | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov02b10.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov02b10.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov02b10.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..75896c57703d8aeafbf4dac694b020bd622257a0
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov02b10.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov02b10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV02B10 CMOS image sensor
+
+maintainers:
+  - Codex <codex@localhost.localdomain>
+
+description:
+  The OV02B10 is a 1600 by 1200 pixel Bayer image sensor with a single-lane
+  MIPI CSI-2 output. This binding describes its external clock, analog and
+  I/O supplies, active-low reset, and CSI-2 connection.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov02b10
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog supply, nominally 2.8 V.
+
+  dovdd-supply:
+    description: Digital I/O supply, nominally 1.8 V.
+
+  reset-gpios:
+    description: Active-low sensor reset.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera-sensor@3c {
+            compatible = "ovti,ov02b10";
+            reg = <0x3c>;
+            clocks = <&sensor_clk>;
+            assigned-clocks = <&sensor_clk>;
+            assigned-clock-rates = <24000000>;
+            reset-gpios = <&gpio 109 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&camera_avdd>;
+            dovdd-supply = <&camera_dovdd>;
+
+            port {
+                ov02b10_out: endpoint {
+                    data-lanes = <1>;
+                    link-frequencies = /bits/ 64 <330000000>;
+                    remote-endpoint = <&csiphy_in>;
+                };
+            };
+        };
+    };
