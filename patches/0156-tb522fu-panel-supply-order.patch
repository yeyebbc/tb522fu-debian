From a00cb6f050e95ef5719d55af4b16f1c1ca03434e Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Fri, 13 Nov 2026 23:02:34 +0800
Subject: [PATCH] drm/panel: preserve TB522FU supply ordering and settle times

Use the stock VDDIO, VCI, TVDD order with a 20 ms settle after VDDIO and TVDD. Unwind already-enabled consumers if a later rail fails. Other panel descriptors retain the bulk-enable path.
---
 drivers/gpu/drm/panel/panel-novatek-nt36536.c | 30 +++++++++++++++++--
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
index 7e32f9a5d944..402e2265516b 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -53,6 +53,7 @@ struct panel_desc {
 	int (*exit_sequence)(struct mipi_dsi_multi_context *dsi_ctx);
 
 	const char *const *supply_names;
+	const unsigned int *supply_on_delays_us;
 	unsigned int num_supplies;
 	unsigned int post_on_delay_us;
 
@@ -68,6 +69,10 @@ static const char *const y900_boe_nt36536e_supplies[] = {
 	"vddio", "vci", "tvdd",
 };
 
+static const unsigned int y900_boe_nt36536e_supply_delays[] = {
+	20000, 0, 20000,
+};
+
 static inline struct novatek *to_novatek(struct drm_panel *panel)
 {
 	return container_of(panel, struct novatek, panel);
@@ -98,10 +103,24 @@ static int novatek_prepare(struct drm_panel *panel)
 {
 	y900_dev_info(panel->dev, "Y900PREP enter\n");
 	struct novatek *ctx = to_novatek(panel);
-	int ret;
+	int ret, i;
 
 	y900_dev_info(panel->dev, "Y900PREP supplies=%d\n", ctx->num_supplies);
-	ret = regulator_bulk_enable(ctx->num_supplies, ctx->supplies);
+	if (ctx->desc->supply_on_delays_us) {
+		/* Stock requires VDDIO to settle before VCI, then TVDD. */
+		for (i = 0; i < ctx->num_supplies; i++) {
+			unsigned int delay = ctx->desc->supply_on_delays_us[i];
+
+			ret = regulator_enable(ctx->supplies[i].consumer);
+			if (ret)
+				goto disable_supplies;
+			if (delay)
+				usleep_range(delay, delay + 1000);
+		}
+		ret = 0;
+	} else {
+		ret = regulator_bulk_enable(ctx->num_supplies, ctx->supplies);
+	}
 	y900_dev_info(panel->dev, "Y900PREP regulator_bulk_enable -> %d\n", ret);
 	if (ret < 0)
 		return ret;
@@ -115,6 +134,11 @@ static int novatek_prepare(struct drm_panel *panel)
 	/* The init sequence is sent from ->enable(): pre_enable walks the bridge
 	 * chain tail-first, so ->prepare() runs before the DSI host is powered. */
 	return 0;
+
+disable_supplies:
+	while (i--)
+		regulator_disable(ctx->supplies[i].consumer);
+	return ret;
 }
 
 static int novatek_enable(struct drm_panel *panel)
@@ -632,8 +656,8 @@ static const struct panel_desc y900_boe_nt36536e_desc = {
 	.init_sequence = y900_boe_nt36536e_init_seq,
 	.exit_sequence = y900_boe_nt36536e_exit_seq,
 	.supply_names = y900_boe_nt36536e_supplies,
+	.supply_on_delays_us = y900_boe_nt36536e_supply_delays,
 	.num_supplies = ARRAY_SIZE(y900_boe_nt36536e_supplies),
-	.post_on_delay_us = 20000,
 	.is_dual_dsi = true,
 	.has_dcs_backlight = false,
 };
