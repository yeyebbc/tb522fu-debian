+/* Stock keyboard: GENI SE15, 921600 8N1, dedicated power/detect lines. */
+&tlmm {
+	gpio-reserved-ranges = <28 2>, <36 4>, <74 1>, <86 3>, <97 2>, <100 1>, <161 1>;
+
+	keyboard_tx: keyboard-tx-state {
+		pins = "gpio30";
+		function = "qup2_se7";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+	keyboard_rx: keyboard-rx-state {
+		pins = "gpio31";
+		function = "qup2_se7";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	keyboard_controls: keyboard-controls-state {
+		outputs {
+			pins = "gpio42", "gpio60", "gpio105", "gpio106", "gpio110";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+		inputs {
+			pins = "gpio11", "gpio43";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			input-enable;
+		};
+	};
+	keyboard_wake_on: keyboard-wake-on-state {
+		pins = "gpio108";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
+	keyboard_wake_off: keyboard-wake-off-state {
+		pins = "gpio108";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+};
+
+&qupv3_2 { status = "okay"; };
+&uart15 {
+	pinctrl-0 = <&keyboard_tx &keyboard_rx>;
+	status = "okay";
+
+	keyboard {
+		compatible = "lenovo,tb522fu-keyboard";
+		vcc3-enable-gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>;
+		vcc5-enable-gpios = <&tlmm 106 GPIO_ACTIVE_HIGH>;
+		ocp-enable-gpios = <&tlmm 110 GPIO_ACTIVE_HIGH>;
+		mode-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		tx-enable-gpios = <&tlmm 60 GPIO_ACTIVE_HIGH>;
+		detect-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+		lid-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "wake-on", "wake-off";
+		pinctrl-0 = <&keyboard_controls &keyboard_wake_off>;
+		pinctrl-1 = <&keyboard_controls &keyboard_wake_on>;
+		pinctrl-2 = <&keyboard_controls &keyboard_wake_off>;
+	};
+};
