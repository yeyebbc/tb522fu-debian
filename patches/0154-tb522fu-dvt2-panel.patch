 };
 
-/* The MDP OPP table in sm8750.dtsi stops at 575 MHz, which makes the DPU
- * reject the panel's 3840x2560@120 mode with MODE_CLOCK_HIGH (~748 MHz are
- * needed).  Add the next step up; the dispcc RCG table grows with it. */
-&mdp_opp_table {
-	opp-750000000 {
-		opp-hz = /bits/ 64 <750000000>;
-		required-opps = <&rpmhpd_opp_turbo>;
-	};
-
-	opp-760000000 {
-		opp-hz = /bits/ 64 <760000000>;
-		required-opps = <&rpmhpd_opp_turbo>;
-	};
-};
-
 /*
  * Charging stack (M207): the PMIC charger (pmih0108) is owned by the ADSP
  * firmware, exactly like on Android.  Linux talks to it through
diff --git a/drivers/clk/qcom/dispcc-sm8750.c b/drivers/clk/qcom/dispcc-sm8750.c
index 4f8ed790b729..6620a45ddb6c 100644
--- a/drivers/clk/qcom/dispcc-sm8750.c
+++ b/drivers/clk/qcom/dispcc-sm8750.c
@@ -659,13 +659,6 @@ static const struct freq_tbl ftbl_disp_cc_mdss_mdp_clk_src[] = {
 	F(417000000, P_DISP_CC_PLL0_OUT_MAIN, 3, 0, 0),
 	F(532000000, P_DISP_CC_PLL0_OUT_MAIN, 3, 0, 0),
 	F(575000000, P_DISP_CC_PLL0_OUT_MAIN, 3, 0, 0),
-	/* 3840x2560@120 on this panel needs 1.4246 GHz * 1.05 / 2 ~= 748 MHz of
-	 * MDP core clock, which the upstream table above did not cover.  The
-	 * VCO range is 249.6 MHz..2.5 GHz, so 1.5 GHz / 2 is in spec. */
-	F(750000000, P_DISP_CC_PLL0_OUT_MAIN, 2, 0, 0),
-	/* 3840x2560@120 needs 1434576 kHz * 105 / 100 / 2 = 753152 kHz; 750 MHz
-	 * was 3 MHz short, so provide the next step. */
-	F(760000000, P_DISP_CC_PLL0_OUT_MAIN, 2, 0, 0),
 	{ }
 };
 
