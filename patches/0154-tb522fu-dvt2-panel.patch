@@ -194,7 +194,6 @@ panel: panel@0 {
 		compatible = "lenovo,y900-boe-nt36536e";
 		reg = <0>;
 
-		vdd-supply = <&vreg_l11b>;
 		vddio-supply = <&vreg_l12b>;
 		vci-supply = <&vreg_l13b>;
 		tvdd-supply = <&vreg_l4b>;
@@ -300,21 +299,6 @@ &qupv3_2 {
