+
+static void sm8750_dphy_reset(struct mipi_csi2phy_device *csi2phy)
+{
+	/* Keep reset asserted until the lane configuration is complete. */
+	writel(1, csi2phy->base + SM8750_PHY_RESET);
+	usleep_range(20, 25);
+}
+
+static int sm8750_dphy_lanes_enable(struct mipi_csi2phy_device *csi2phy,
+				   struct mipi_csi2phy_stream_cfg *cfg)
+{
+	const struct mipi_csi2phy_lanes_cfg *lanes = &cfg->lane_cfg;
+	u64 settle_ns, count;
+	u32 enabled, status;
+	u8 settle;
+	int i, ret;
+
+	if (cfg->link_freq <= 0 || !csi2phy->timer_clk_rate ||
+	    !cfg->num_data_lanes || cfg->num_data_lanes > CSI2_MAX_DATA_LANES)
+		return -EINVAL;
+
+	/* Deskew negotiation is not implemented; limit the per-lane rate. */
+	if (cfg->link_freq > 750000000)
+		return -EOPNOTSUPP;
+
+	if (lanes->clk.pos != CSI2_DEFAULT_CLK_LANE || lanes->clk.pol)
+		return -EOPNOTSUPP;
+
+	enabled = BIT(CSI2_DEFAULT_CLK_LANE);
+	for (i = 0; i < cfg->num_data_lanes; i++) {
+		if (lanes->data[i].pos >= CSI2_MAX_DATA_LANES)
+			return -EINVAL;
+		if (lanes->data[i].pol)
+			return -EOPNOTSUPP;
+		if (enabled & BIT(2 * lanes->data[i].pos))
+			return -EINVAL;
+		enabled |= BIT(2 * lanes->data[i].pos);
+	}
+
+	/* v2.3.0: floor((85 ns + 6 UI) * timer_rate) - 10, UI = 1/bitrate. */
+	settle_ns = 85 + div64_u64(6ULL * NSEC_PER_SEC, 2ULL * cfg->link_freq);
+	count = div_u64(settle_ns * csi2phy->timer_clk_rate, NSEC_PER_SEC);
+	if (count <= 10 || count - 10 > 0xff)
+		return -ERANGE;
+	settle = count - 10;
+
+	ret = readl_poll_timeout(csi2phy->base + SM8750_PHY_REFGEN_STATUS,
+				status, status & SM8750_PHY_REFGEN_READY, 500, 10000);
+	if (ret) {
+		dev_err(csi2phy->dev, "Reference generator not ready: %#x\n", status);
+		return ret;
+	}
+
+	writel(enabled, csi2phy->base + SM8750_PHY_LANES);
+	writel(0, csi2phy->base + 0x1084);
+	writel(0, csi2phy->base + SM8750_PHY_MODE);
+	/* The stock common sequence delays at both D-PHY and C-PHY entries. */
+	usleep_range(2, 12);
+	writel(0x7a, csi2phy->base + SM8750_PHY_CTRL7);
+	writel(1, csi2phy->base + SM8750_PHY_POWER);
+
+	for (i = 0; i < ARRAY_SIZE(sm8750_dphy_init); i++) {
+		const struct mipi_csi2phy_lane_regs *r = &sm8750_dphy_init[i];
+		u32 val = r->reg_data;
+
+		if (r->param_type == CSIPHY_SETTLE_CNT_LOWER_BYTE)
+			val = settle;
+		else if (r->param_type == CSIPHY_SKEW_CAL)
+			val = 0;
+
+		writel(val, csi2phy->base + r->reg_addr);
+		if (r->delay_us)
+			usleep_range(r->delay_us, r->delay_us + 5);
+	}
+
+	/* The generic PHY has no IRQ handler: keep the eleven sources masked. */
+	for (i = 0; i < 11; i++)
+		writel(0, csi2phy->base + 0x102c + 4 * i);
+
+	/* Non-combo D-PHY reset release, after every lane has been configured. */
+	writel(2, csi2phy->base + SM8750_PHY_RESET);
+	usleep_range(10, 15);
+
+	return 0;
+}
+
+static void sm8750_dphy_lanes_disable(struct mipi_csi2phy_device *csi2phy,
+				     struct mipi_csi2phy_stream_cfg *cfg)
+{
+	writel(0, csi2phy->base + 0x1084);
+	writel(0, csi2phy->base + SM8750_PHY_MODE);
+	usleep_range(2, 12);
+	writel(0, csi2phy->base + SM8750_PHY_CTRL7);
+	writel(0, csi2phy->base + SM8750_PHY_POWER);
+	writel(0, csi2phy->base + SM8750_PHY_LANES);
+	sm8750_dphy_reset(csi2phy);
+}
+
+static const struct mipi_csi2phy_hw_ops sm8750_dphy_ops = {
+	.reset = sm8750_dphy_reset,
+	.lanes_enable = sm8750_dphy_lanes_enable,
+	.lanes_disable = sm8750_dphy_lanes_disable,
+};
+
+static const char * const sm8750_clks[] = { "core", "timer", "ahb" };
+static const char * const sm8750_supplies[] = { "vdda-0p9", "vdda-1p2" };
+
+static const struct mipi_csi2_genpd sm8750_genpds[] = {
+	{ .name = "top", .scaled = false },
+	{ .name = "mmcx", .scaled = true },
+	{ .name = "mx", .scaled = true },
+};
+
+const struct mipi_csi2phy_soc_cfg mipi_csi2_dphy_sm8750 = {
+	.ops = &sm8750_dphy_ops,
+	.reg_info = {
+		.common_regs_offset = 0x1000,
+		.common_status_offset = 0x138,
+	},
+	.supply_names = (const char **)sm8750_supplies,
+	.num_supplies = ARRAY_SIZE(sm8750_supplies),
+	.clk_names = (const char **)sm8750_clks,
+	.num_clk = ARRAY_SIZE(sm8750_clks),
+	.genpds = sm8750_genpds,
+	.num_genpds = ARRAY_SIZE(sm8750_genpds),
+};
