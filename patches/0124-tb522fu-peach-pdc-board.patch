Subject: [PATCH] arm64: dts: qcom: tb522fu: use stock Peach PDC votes

Use the stock CNSS rail map, initial PDC messages, SW-control pinmux and
host-SOL default. The Peach sequencer supplies per-consumer active votes
instead of raising shared RF regulator minima globally.

---
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
@@ -654,15 +654,29 @@
 	};
 };
 
-/* Match the stock CNSS active RF votes; maxima stay unchanged. */
-&vreg_s3g { regulator-min-microvolt = <1860000>; };
-&vreg_s7i { regulator-min-microvolt = <1312000>; };
+/* The Peach sequencer votes stock CNSS active RF ranges per consumer. */
 
 / {
-	wcn7860-pmu {
-		compatible = "qcom,wcn7860-pmu";
+	wcn7861-pmu {
+		compatible = "qcom,wcn7861-pmu";
+		/* Stock CNSS PDC table and PMU pin-to-external-rail mappings. */
+		qcom,qmp = <&aoss_qmp>;
+		qcom,pdc-init-table =
+			"{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}",
+			"{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}",
+			"{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}",
+			"{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
+		qcom,vreg-pdc-map = "s5f:rf", "s4d:bb", "s3g:rf", "s7i:rf";
+		qcom,pmu-vreg-map =
+			"VDDD_AON_0P9:s5f", "VDDA_RFA_1P9:s3g", "VDDA_RFA_1P3:s7i",
+			"VDDA_RFA_0P9:s5f", "VDDD_WLMX_0P9:s4d", "VDDD_WLCX_0P9:s5f",
+			"VDDD_BTCX_0P9:s5f", "VDDD_BTCMX_0P9:s5f",
+			"VDDA_PCIE_1P2:s7i", "VDDA_PCIE_0P9:s7i";
+		vdd-supply = <&vreg_s5f_wlan>;
+
 		pinctrl-names = "default";
-		pinctrl-0 = <&wlan_en_default>;
+		pinctrl-0 = <&wlan_en_default>, <&wlan_sw_ctrl>,
+			    <&wlan_sw_ctrl_wl_cx>, <&wlan_host_sol>;
 		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
 		vddio-supply = <&vreg_l3f>;
 		vddio1p2-supply = <&vreg_l2f>;
@@ -686,6 +700,22 @@
 };
 
 &tlmm {
+	wlan_sw_ctrl: wlan-sw-ctrl-state {
+		pins = "gpio18";
+		function = "wcn_sw_ctrl";
+	};
+	wlan_sw_ctrl_wl_cx: wlan-sw-ctrl-wl-cx-state {
+		pins = "gpio19";
+		function = "wcn_sw";
+	};
+	wlan_host_sol: wlan-host-sol-state {
+		pins = "gpio202";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-pull-down;
+		/* Stock cnss_power_on_device drives host SOL low. */
+		output-low;
+	};
 	wlan_en_default: wlan-en-default-state {
 		pins = "gpio16";
 		function = "gpio";
