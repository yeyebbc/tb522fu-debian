From 839abfa95a7260d193257d594bd06860ba071fe1 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 16 Nov 2026 23:01:38 +0800
Subject: [PATCH] drm/panel: novatek: add opt-in Lenovo power-mode observation

Add a default-off, read-only module parameter for the BOE board. After
successful initialization, PPS and backlight enable, query one standard
DCS power-mode byte through the primary physical host. Reads do not use
the bonded write-broadcast path.

Record the API result and byte separately; an unavailable response must
not look like a successful zero status or change normal enable errors.
Other panels and boots without the parameter retain their behavior.
This is a bounded diagnostic, not evidence of panel readback support or
a display-wake fix. Keep all board power, clock and packet settings.
---
 drivers/gpu/drm/panel/panel-novatek-nt36536.c | 29 ++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36536.c b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
index 3192e44ad8ee..f328c7882f52 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36536.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36536.c
@@ -62,6 +62,10 @@ struct panel_desc {
 	bool has_dcs_backlight;
 };
 
+static bool power_mode_probe;
+module_param(power_mode_probe, bool, 0400);
+MODULE_PARM_DESC(power_mode_probe, "Read BOE panel power mode after enable");
+
 static const char *const csot_pp8807hb1_1_supplies[] = {
 	"vddio", "vsp", "vsn",
 };
@@ -142,6 +146,22 @@ static int novatek_prepare(struct drm_panel *panel)
 	return ret;
 }
 
+static void novatek_read_power_mode(struct novatek *ctx)
+{
+	u8 mode = 0;
+	int ret;
+
+	if (!power_mode_probe ||
+	    !of_device_is_compatible(ctx->dsi[0]->dev.of_node,
+				     "lenovo,y900-boe-nt36536e"))
+		return;
+
+	/* Reads target the primary physical host, without bonded broadcast. */
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi[0], &mode);
+	dev_info(ctx->panel.dev, "DISPLAY_PANEL_POWER host=0 ret=%d mode=%#x\n",
+		 ret, mode);
+}
+
 static int novatek_enable(struct drm_panel *panel)
 {
 	struct novatek *ctx = to_novatek(panel);
@@ -182,7 +202,14 @@ static int novatek_enable(struct drm_panel *panel)
 	if (ret < 0)
 		return ret;
 
-	return backlight_enable(ctx->backlight);
+	ret = backlight_enable(ctx->backlight);
+	if (ret < 0)
+		return ret;
+
+	/* Observe only the successfully initialized and powered BOE panel. */
+	novatek_read_power_mode(ctx);
+
+	return 0;
 }
 
 static int novatek_off(struct mipi_dsi_multi_context *dsi_ctx)
-- 
