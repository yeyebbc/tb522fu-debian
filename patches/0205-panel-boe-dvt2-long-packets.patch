+	y900_dcs_long_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x02, 0x42);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x1c, 0xaa);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x1d, 0x0a);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0xff, 0x10);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x3b, 0x03, 0x12, 0x1a, 0x04,
+				      0x04, 0x01, 0x80, 0x36, 0x36);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x60, 0x00);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x90, 0x03, 0x00);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x91, 0xab, 0xa8, 0x00, 0x14,
+				      0xd2, 0x00, 0x00, 0x00, 0x02, 0x52, 0x00,
+				      0x0d, 0x05, 0x7a, 0x02, 0xdd);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0x92, 0x10, 0xf0);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0xb2, 0x91, 0x80);
+	y900_dcs_long_write_seq_multi(dsi_ctx, 0xb3, 0x40);
 	mipi_dsi_msleep(dsi_ctx, 16);
 	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
 	mipi_dsi_msleep(dsi_ctx, 105);
