From 4c1e0c2b6c64b250c4161e5f63ea854706be5d8d Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Thu, 24 Sep 2026 20:12:13 +0800
Subject: [PATCH] ASoC: qcom: audioreach: configure legacy TDM endpoints

Legacy TDM sink/source modules use a different interface and frame-size
ABI from Audio IF modules. Add their wire layouts and construct aligned
SET_CFG records with the actual unpadded parameter lengths. Reuse the
existing serial-slot topology tokens and reject unsupported bit-clock
requests rather than interpreting them as firmware defaults.

The initial path supports PCM with firmware-default clocks. Validate
slot, lane and format bounds before allocating a command. Existing
Audio IF and codec-DMA media-format paths remain separate.

The production sender matches the five parameter blocks extracted from
the board stock ACDB. ARM64 W=1 compilation and host payload/failure
checks pass; DSP command acceptance and physical playback are untested.

Link: https://github.com/AudioReach/audioreach-graphservices/blob/14cedc9ec46afc3d5bae89e1fcf8be94aef76548/spf/api/modules/pcm_tdm_api.h

Assisted-by: LLM

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/audioreach.c | 101 ++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/audioreach.h |  33 ++++++++++
 sound/soc/qcom/qdsp6/topology.c   |   5 ++
 3 files changed, 139 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index cce0ad31ff0c..2f28ac9b8382 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -166,6 +166,27 @@ struct apm_module_hw_ep_mf_cfg {
 
 #define APM_HW_EP_CFG_PSIZE ALIGN(sizeof(struct apm_module_hw_ep_mf_cfg), 8)
 
+/* Each record is aligned to eight bytes; param_size excludes the padding. */
+struct apm_tdm_config {
+	struct apm_module_param_data intf_param;
+	struct param_id_tdm_intf_cfg intf;
+	u32 intf_padding;
+	struct apm_module_param_data media_param;
+	struct param_id_hw_ep_mf media;
+	u32 media_padding;
+	struct apm_module_param_data frame_param;
+	struct param_id_fram_size_factor frame;
+	u32 frame_padding;
+	struct apm_module_param_data lane_param;
+	struct param_id_tdm_lane_cfg lane;
+	u32 lane_padding;
+	struct apm_module_param_data clock_param;
+	struct param_id_hw_intf_clk_cfg clock;
+} __packed;
+
+static_assert(sizeof(struct param_id_tdm_intf_cfg) == 28);
+static_assert(sizeof(struct apm_tdm_config) == 160);
+
 #define APM_MFC_CFG_PSIZE(p, n) ALIGN(struct_size(p, channel_mapping, n), 4)
 
 struct apm_module_frame_size_factor_cfg {
@@ -1066,6 +1087,82 @@ static int audioreach_i2s_set_media_format(struct q6apm_graph *graph,
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
 }
 
+static void audioreach_tdm_init_param(struct apm_module_param_data *param,
+				      u32 instance, u32 id, u32 size)
+{
+	param->module_instance_id = instance;
+	param->param_id = id;
+	param->param_size = size;
+	param->error_code = 0;
+}
+
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					 const struct audioreach_module *module,
+					 const struct audioreach_module_config *cfg)
+{
+	u32 mask = cfg->slot_mask ?: module->slot_mask;
+	u16 slots = cfg->nslots_per_frame ?: module->nslots_per_frame;
+	u16 width = cfg->slot_width ?: module->slot_width;
+	struct apm_tdm_config *data;
+
+	if (!slots || slots > 32 || !mask || mask & ~GENMASK(slots - 1, 0) ||
+	    (width != 16 && width != 24 && width != 32) ||
+	    !cfg->num_channels || cfg->num_channels > 32 || !cfg->sample_rate ||
+	    module->data_format != DATA_FORMAT_FIXED_POINT ||
+	    (cfg->bit_width != 16 && cfg->bit_width != 24 && cfg->bit_width != 32) ||
+	    cfg->bit_width > width || !module->active_lane_mask ||
+	    module->active_lane_mask > U16_MAX || module->hw_interface_type > 4 ||
+	    module->hw_interface_idx > 4 || module->sync_src > 1 ||
+	    module->ctrl_data_out_enable > 1 || module->sync_mode > 2 ||
+	    module->ctrl_invert_sync_pulse > 1 || module->ctrl_sync_data_delay > 2)
+		return -EINVAL;
+
+	/* The legacy clock parameter currently requests firmware defaults. */
+	if (module->bit_clk_type || module->inv_int_bit_clk || module->inv_ext_bit_clk ||
+	    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK))
+		return -EOPNOTSUPP;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(sizeof(*data), APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	data = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	audioreach_tdm_init_param(&data->intf_param, module->instance_id,
+				 PARAM_ID_TDM_INTF_CFG, sizeof(data->intf));
+	data->intf.lpaif_type = module->hw_interface_type;
+	data->intf.intf_idx = module->hw_interface_idx;
+	data->intf.sync_src = module->sync_src;
+	data->intf.ctrl_data_out_enable = module->ctrl_data_out_enable;
+	data->intf.slot_mask = mask;
+	data->intf.nslots_per_frame = slots;
+	data->intf.slot_width = width;
+	data->intf.sync_mode = module->sync_mode;
+	data->intf.ctrl_invert_sync_pulse = module->ctrl_invert_sync_pulse;
+	data->intf.ctrl_sync_data_delay = module->ctrl_sync_data_delay;
+
+	audioreach_tdm_init_param(&data->media_param, module->instance_id,
+				 PARAM_ID_HW_EP_MF_CFG, sizeof(data->media));
+	data->media.sample_rate = cfg->sample_rate;
+	data->media.bit_width = cfg->bit_width;
+	data->media.num_channels = cfg->num_channels;
+	data->media.data_format = module->data_format;
+
+	audioreach_tdm_init_param(&data->frame_param, module->instance_id,
+				 PARAM_ID_HW_EP_FRAME_SIZE_FACTOR, sizeof(data->frame));
+	data->frame.frame_size_factor = module->frame_size_factor ?: 1;
+
+	audioreach_tdm_init_param(&data->lane_param, module->instance_id,
+				 PARAM_ID_TDM_LANE_CFG, sizeof(data->lane));
+	data->lane.lane_mask = module->active_lane_mask;
+
+	/* Zero ID, frequency, attributes and root select the firmware defaults. */
+	audioreach_tdm_init_param(&data->clock_param, module->instance_id,
+				 PARAM_ID_HW_INTF_CLK_CFG, sizeof(data->clock));
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
+
 static int audioreach_audio_if_set_media_format(struct q6apm_graph *graph,
 						const struct audioreach_module *module,
 						const struct audioreach_module_config *cfg)
@@ -1531,6 +1628,10 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 	case MODULE_ID_AUDIO_IF_SINK:
 		rc = audioreach_audio_if_set_media_format(graph, module, cfg);
 		break;
+	case MODULE_ID_TDM_SOURCE:
+	case MODULE_ID_TDM_SINK:
+		rc = audioreach_tdm_set_media_format(graph, module, cfg);
+		break;
 
 	default:
 		rc = 0;
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 35541b2d8c99..1330591528d4 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -22,6 +22,8 @@ struct q6apm_graph;
 #define MODULE_ID_PLACEHOLDER_DECODER	0x07001009
 #define MODULE_ID_I2S_SINK		0x0700100A
 #define MODULE_ID_I2S_SOURCE		0x0700100B
+#define MODULE_ID_TDM_SINK		0x0700100E
+#define MODULE_ID_TDM_SOURCE		0x0700100F
 #define MODULE_ID_SAL			0x07001010
 #define MODULE_ID_MFC			0x07001015
 #define MODULE_ID_DATA_LOGGING		0x0700101A
@@ -548,6 +550,37 @@ struct param_id_i2s_intf_cfg {
 
 #define PARAM_ID_AUDIO_IF_INTF_CFG	0x08001B11
 
+#define PARAM_ID_TDM_INTF_CFG		0x0800101B
+#define PARAM_ID_TDM_LANE_CFG		0x0800106A
+#define PARAM_ID_HW_INTF_CLK_CFG		0x0800113C
+
+/* Legacy SPF TDM ABI: no version word precedes the interface fields. */
+struct param_id_tdm_intf_cfg {
+	u32 lpaif_type;
+	u32 intf_idx;
+	u16 sync_src;
+	u16 ctrl_data_out_enable;
+	u32 slot_mask;
+	u16 nslots_per_frame;
+	u16 slot_width;
+	u16 sync_mode;
+	u16 ctrl_invert_sync_pulse;
+	u16 ctrl_sync_data_delay;
+	u16 reserved;
+} __packed;
+
+struct param_id_tdm_lane_cfg {
+	u16 lane_mask;
+	u16 reserved;
+} __packed;
+
+struct param_id_hw_intf_clk_cfg {
+	u32 clock_id;
+	u32 clock_freq;
+	u32 clock_attri;
+	u32 clock_root;
+} __packed;
+
 /*
  * struct param_id_audio_if_intf_cfg - Audio interface configuration
  * @qaif_type: Audio interface type (e.g. QAIF, QAIF_VA)
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index faafbc5c0ad0..7cc6f89d6127 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -765,6 +765,9 @@ static int audioreach_widget_audio_if_module_load(struct audioreach_module *mod,
 	while (tkn_count < le32_to_cpu(mod_array->num_elems)) {
 		val = le32_to_cpu(mod_elem->value);
 		switch (le32_to_cpu(mod_elem->token)) {
+		case AR_TKN_U32_MODULE_HW_IF_TYPE:
+			mod->hw_interface_type = val;
+			break;
 		case AR_TKN_U32_MODULE_HW_IF_IDX:
 			mod->hw_interface_idx = val;
 			break;
@@ -905,6 +908,8 @@ static int audioreach_widget_load_buffer(struct snd_soc_component *component,
 		break;
 	case MODULE_ID_AUDIO_IF_SINK:
 	case MODULE_ID_AUDIO_IF_SOURCE:
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
 		ret = audioreach_widget_audio_if_module_load(mod, mod_array);
 		if (ret)
 			return ret;
-- 
