From fab0409b24f430731d05f609b2fe8061c2f5513e Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Sun, 18 Oct 2026 11:43:36 +0800
Subject: [PATCH] ASoC: qcom: q6apm: start capture graphs from PCM trigger

PCM prepare configures a stream; it need not start data transfer. In
sound/core/pcm_native.c, snd_pcm_do_prepare()/snd_pcm_post_prepare()
leave the stream PREPARED, snd_pcm_do_start() invokes trigger START,
and snd_pcm_drop() stops the stream without requiring a prior START.

On piano, WirePlumber device probes prepare and free capture streams
without triggering START. Three tracing runs on 2026-10-18 and the
subsequent RAM candidate test associate the failures with capture FE
START plus eight READ requests followed by STOP/CLOSE within 1 ms.
Moving FE STOP into hw_free changed the first timeout from BE CLOSE
to FE STOP on cycle five, but did not prevent the firmware stall.

Keep capture graphs PREPARED until START, RESUME or PAUSE_RELEASE,
then start the graph and queue capture buffers. Propagate start and
initial read errors. A nonzero PREPARED state retains fragment cleanup;
graph_stop already skips graphs whose start_count is zero. No retry,
delay or DSP reset is added.

Playback still starts in prepare because ack queues data when appl_ptr
advances. Aligning playback startup is a separate follow-up.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
(cherry picked from commit 3a5e957a04fe2f11255ff2669ea00c8926defc96)
---
 sound/soc/qcom/qdsp6/q6apm-dai.c | 32 ++++++++++++++++++++++----------
 1 file changed, 22 insertions(+), 10 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 3aeac5590279..c7e2fcaecc13 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -55,6 +55,7 @@ enum stream_state {
 	Q6APM_STREAM_IDLE = 0,
 	Q6APM_STREAM_STOPPED,
 	Q6APM_STREAM_RUNNING,
+	Q6APM_STREAM_PREPARED,
 };
 
 struct q6apm_dai_rtd {
@@ -294,21 +295,17 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 		return ret;
 	}
 
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		prtd->state = Q6APM_STREAM_PREPARED;
+		return 0;
+	}
+
 	ret = q6apm_graph_start(prtd->graph);
 	if (ret) {
 		dev_err(dev, "Failed to Start Graph %d\n", ret);
 		return ret;
 	}
-	if (!q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
-		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
-			int i;
-			/* Queue the buffers for Capture ONLY after graph is started */
-			for (i = 0; i < runtime->periods; i++)
-				q6apm_read(prtd->graph);
-		}
-	}
 
-	/* Now that graph as been prepared and started update the internal state accordingly */
 	prtd->state = Q6APM_STREAM_RUNNING;
 
 	return 0;
@@ -343,12 +340,27 @@ static int q6apm_dai_trigger(struct snd_soc_component *component,
 {
 	struct snd_pcm_runtime *runtime = substream->runtime;
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
-	int ret = 0;
+	int i, ret = 0;
 
 	switch (cmd) {
 	case SNDRV_PCM_TRIGGER_START:
 	case SNDRV_PCM_TRIGGER_RESUME:
 	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+		    prtd->state == Q6APM_STREAM_PREPARED) {
+			ret = q6apm_graph_start(prtd->graph);
+			if (ret)
+				return ret;
+
+			if (!q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
+				for (i = 0; i < runtime->periods; i++) {
+					ret = q6apm_read(prtd->graph);
+					if (ret < 0)
+						return ret;
+				}
+			}
+			prtd->state = Q6APM_STREAM_RUNNING;
+		}
 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
 		/* TODO support be handled via SoftPause Module */
-- 
2.47.3

