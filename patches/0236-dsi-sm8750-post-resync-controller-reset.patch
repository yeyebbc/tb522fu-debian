From 63ffe260b42f2c80866fc5db47f05613af186e0b Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Thu, 8 Oct 2026 19:54:27 +0000
Subject: [PATCH] drm/msm/dsi: Reset SM8750 bonded controllers after PHY resync

After both HS clock paths and the two PHY synchronization passes
complete, reset each SM8750 bonded video controller before IRQs or
panel commands. The existing per-host reset runs earlier, inside
host_power_on, before the link clocks and the PHY resync. Preserve the
controller and clock-control values around this later reset, clearing
all three engine enable bits and using the OEM v7.2 dynamic clock-force
mask. The reset pulse is the OEM 1 us. This is a controller-only reset:
no PHY reset, PLL change, lane exchange, DSC change or panel delay is
added.

Restrict the additional reset to bonded video and the actual controller
compatible qcom,sm8750-dsi-ctrl. If either reset fails its
powered/not-enabled precondition, unwind both powered hosts before the
existing PHY cleanup.

The vendor display driver does the same in dsi_display_prepare(): link
clocks on (whose post-on callback toggles the PHY retime FIFOs and
releases CLK_EN_SEL), then dsi_display_soft_reset() on every controller,
then panel prepare (MiCode vendor_opensource_display-drivers
aa06fd1757c28dce96fbe4e04d4530ec21b52aac, msm/dsi/dsi_display.c
1677-1701, 4277-4285, 9385-9417; msm/dsi/dsi_ctrl_hw_cmn.c 22, 304-330).

Imported from Project-SunUEFI patches/linux/7.2.9/
0015-dsi-sm8750-post-resync-controller-reset.patch (commit 7952663,
slwyts); applied unchanged to this tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

(cherry picked from commit 9a8a1df0d0a5a16635348b9415c4b76375d08181)

Imported from https://github.com/yzddmr6/linux-sm8750-erhai/commit/3b4689ae948f0e3fd36fa9b09ade279ae36d4c6b
Context adapted to retain the existing clock-parking helper after the new reset helper; functional additions unchanged.
---
 drivers/gpu/drm/msm/dsi/dsi.h         |  1 +
 drivers/gpu/drm/msm/dsi/dsi_host.c    | 48 +++++++++++++++++++++++++++
 drivers/gpu/drm/msm/dsi/dsi_manager.c | 12 +++++++
 3 files changed, 61 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 777c7e111a3a..e8f458bbc766 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -80,6 +80,7 @@ int msm_dsi_host_power_on(struct mipi_dsi_host *host,
 			struct msm_dsi_phy_shared_timings *phy_shared_timings,
 			bool is_bonded_dsi, struct msm_dsi_phy *phy);
 int msm_dsi_host_power_off(struct mipi_dsi_host *host);
+int msm_dsi_host_reset_after_phy_sync(struct mipi_dsi_host *host);
 int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
 				  const struct drm_display_mode *mode);
 enum drm_mode_status msm_dsi_host_check_dsc(struct mipi_dsi_host *host,
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index e1671b8e2c2e..5b1edd0b4c8a 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2757,6 +2757,54 @@ int msm_dsi_host_power_on(struct mipi_dsi_host *host,
 	return ret;
 }
 
+/*
+ * SM8750 bonded video requires a controller reset after both HS clock paths
+ * and PHY retime FIFOs have settled. Do not reset the PHY here: that would
+ * discard the synchronization which the manager has just completed.
+ */
+int msm_dsi_host_reset_after_phy_sync(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 ctrl, clk_ctrl;
+	int ret = 0;
+
+	if (!of_device_is_compatible(msm_host->pdev->dev.of_node,
+				     "qcom,sm8750-dsi-ctrl") ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return 0;
+
+	mutex_lock(&msm_host->dev_mutex);
+	/* The manager calls before IRQs, panel commands or video are enabled. */
+	if (!msm_host->power_on || msm_host->enabled) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+
+	ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+	clk_ctrl = dsi_read(msm_host, REG_DSI_CLK_CTRL);
+	dsi_write(msm_host, REG_DSI_CTRL,
+		  ctrl & ~(DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN |
+			   DSI_CTRL_CMD_MODE_EN));
+	wmb();
+
+	/* MiCode v7.2 dynamic force-on mask; preserve every existing bit. */
+	dsi_write(msm_host, REG_DSI_CLK_CTRL,
+		  clk_ctrl | 0x23f | BIT(8) | BIT(9) | BIT(11) | BIT(21));
+	wmb();
+	dsi_write(msm_host, REG_DSI_RESET, 1);
+	wmb();
+	udelay(1);
+	dsi_write(msm_host, REG_DSI_RESET, 0);
+	wmb();
+	dsi_write(msm_host, REG_DSI_CLK_CTRL, clk_ctrl);
+	wmb();
+	dsi_write(msm_host, REG_DSI_CTRL, ctrl);
+	wmb();
+unlock:
+	mutex_unlock(&msm_host->dev_mutex);
+	return ret;
+}
+
 static int dsi_link_clk_park(struct msm_dsi_host *msm_host)
 {
 	struct device *dev = &msm_host->pdev->dev;
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 4e9ff2da6093..124d9be07a80 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -257,6 +257,16 @@ static int dsi_mgr_bridge_power_on(struct drm_bridge *bridge)
 	if (is_bonded_dsi && msm_dsi1)
 		msm_dsi_phy_reset_clk_en_sel(msm_dsi1->phy);
 
+	/* OEM bonded-video prepare resets both controllers after PHY resync. */
+	if (is_bonded_dsi && msm_dsi1) {
+		ret = msm_dsi_host_reset_after_phy_sync(host);
+		if (ret)
+			goto host_sync_fail;
+		ret = msm_dsi_host_reset_after_phy_sync(msm_dsi1->host);
+		if (ret)
+			goto host_sync_fail;
+	}
+
 	/*
 	 * Enable before preparing the panel, disable after unpreparing, so
 	 * that the panel can communicate over the DSI link.
@@ -267,6 +277,8 @@ static int dsi_mgr_bridge_power_on(struct drm_bridge *bridge)
 
 	return 0;
 
+host_sync_fail:
+	msm_dsi_host_power_off(msm_dsi1->host);
 host1_on_fail:
 	msm_dsi_host_power_off(host);
 host_on_fail:
-- 
