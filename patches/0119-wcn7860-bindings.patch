From b653e660e4317dc601d1e835752a7cc0164d0555 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Mon, 21 Sep 2026 23:44:08 +0800
Subject: [PATCH] dt-bindings: net: bluetooth: qcom: document the WCN7860

The WCN7860 support in hci_qca and pwrseq-qcom-wcn added the
"qcom,wcn7860-bt" and "qcom,wcn7860-pmu" compatibles to the drivers but not
to the schemas, so a board that uses them has no binding to be checked
against.

Both parts describe hardware the existing schemas already cover. The
Bluetooth module takes the same seven PMU outputs as the WCN7850 one, so it
joins that enum. The PMU takes the WCN7850 set of host inputs minus vdd,
matching pwrseq_wcn7860_vregs[], so it gets its own required-supplies branch.

Assisted-by: LLM
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../bindings/net/bluetooth/qcom,wcn7850-bt.yaml    |  3 ++-
 .../bindings/regulator/qcom,qca6390-pmu.yaml       | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/net/bluetooth/qcom,wcn7850-bt.yaml b/Documentation/devicetree/bindings/net/bluetooth/qcom,wcn7850-bt.yaml
index 8108ef83e99b9..696f09a6bdb33 100644
--- a/Documentation/devicetree/bindings/net/bluetooth/qcom,wcn7850-bt.yaml
+++ b/Documentation/devicetree/bindings/net/bluetooth/qcom,wcn7850-bt.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/bluetooth/qcom,wcn7850-bt.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Qualcomm WCN7850 Bluetooth
+title: Qualcomm WCN7850/WCN7860 Bluetooth
 
 maintainers:
   - Bartosz Golaszewski <brgl@bgdev.pl>
@@ -15,6 +15,7 @@ properties:
   compatible:
     enum:
       - qcom,wcn7850-bt
+      - qcom,wcn7860-bt
 
   enable-gpios:
     maxItems: 1
diff --git a/Documentation/devicetree/bindings/regulator/qcom,qca6390-pmu.yaml b/Documentation/devicetree/bindings/regulator/qcom,qca6390-pmu.yaml
index 105174df7df27..83106b7a4f699 100644
--- a/Documentation/devicetree/bindings/regulator/qcom,qca6390-pmu.yaml
+++ b/Documentation/devicetree/bindings/regulator/qcom,qca6390-pmu.yaml
@@ -27,6 +27,7 @@ properties:
           - qcom,wcn6750-pmu
           - qcom,wcn6855-pmu
           - qcom,wcn7850-pmu
+          - qcom,wcn7860-pmu
 
   vdd-supply:
     description: VDD supply regulator handle
@@ -182,6 +183,19 @@ allOf:
         - vdddig-supply
         - vddrfa1p2-supply
         - vddrfa1p8-supply
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,wcn7860-pmu
+    then:
+      required:
+        - vddio-supply
+        - vddio1p2-supply
+        - vddaon-supply
+        - vdddig-supply
+        - vddrfa1p2-supply
+        - vddrfa1p8-supply
 
 additionalProperties: false
 
