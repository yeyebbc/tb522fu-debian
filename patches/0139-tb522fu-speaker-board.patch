From 49fa21b7cce50ae8612527c9a29422d4f44ee236 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Fri, 13 Nov 2026 18:42:13 +0800
Subject: [PATCH] arm64: qcom: wire TB522FU six-speaker secondary TDM audio

---
 .../bindings/sound/qcom,sm8250.yaml           |  10 ++
 .../boot/dts/qcom/sm8750-lenovo-y900-acm.dts  | 165 ++++++++++++++++++
 sound/soc/qcom/sc8280xp.c                     |  23 ++-
 3 files changed, 194 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
index 1536fcd96d68..0522db0a57b3 100644
--- a/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,sm8250.yaml
@@ -73,6 +73,16 @@ properties:
     $ref: /schemas/types.yaml#/definitions/string
     description: User visible long sound card name
 
+  widgets:
+    $ref: /schemas/types.yaml#/definitions/non-unique-string-array
+    description: |
+      Board sound widgets as pairs of widget type and board-specific name.
+      The common Qualcomm card parser registers these before audio routes.
+
+  pin-switches:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    description: Board widget names for which to create DAPM pin switches.
+
 patternProperties:
   ".*-dai-link$":
     description:
diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
index 84025eace70c..e5d8aa63004d 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
@@ -758,3 +758,168 @@ wifi@0 {
 		vddpcie1p8-supply = <&wlan_pmu_pcie1p8>;
 	};
 };
+
+/* TB522FU stock secondary TDM: GPIO121 clock, 123 sync, 124 SD1 output.
+ * Six AW88461s share active-low reset GPIO120. The private ACF selects each
+ * amplifier's receive slot; never replace it with another board's tuning.
+ */
+/ {
+	tb522fu_sound: sound {
+		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
+		model = "TB522FU";
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb522fu_tdm_clk &tb522fu_tdm_ws &tb522fu_tdm_data>;
+		widgets = "Speaker", "Speaker0", "Speaker", "Speaker1",
+			  "Speaker", "Speaker2", "Speaker", "Speaker3",
+			  "Speaker", "Speaker4", "Speaker", "Speaker5";
+		audio-routing = "Speaker0", "Spkr0 OUT", "Speaker1", "Spkr1 OUT",
+				"Speaker2", "Spkr2 OUT", "Speaker3", "Spkr3 OUT",
+				"Speaker4", "Spkr4 OUT", "Speaker5", "Spkr5 OUT";
+		pin-switches = "Speaker0", "Speaker1", "Speaker2",
+			       "Speaker3", "Speaker4", "Speaker5";
+
+		speaker-dai-link {
+			link-name = "Secondary TDM Speakers";
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-tx-mask = <1 1 1 1 1 1 1 1>;
+				dai-tdm-slot-rx-mask = <0>;
+			};
+			codec {
+				sound-dai = <&tb522fu_amp0>, <&tb522fu_amp1>,
+					    <&tb522fu_amp2>, <&tb522fu_amp3>,
+					    <&tb522fu_amp4>, <&tb522fu_amp5>;
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-tx-mask = <0>;
+				dai-tdm-slot-rx-mask = <1 1 1 1 1 1 1 1>;
+			};
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+};
+
+&remoteproc_adsp {
+	glink-edge {
+		gpr { status = "okay"; };
+	};
+};
+
+&q6apm {
+	firmware-name = "qcom/sm8750/lenovo/tb522fu/tb522fu-speakers.tplg";
+};
+
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	dai@28 {
+		reg = <SECONDARY_TDM_RX_0>;
+		clocks = <&q6prmcc LPASS_CLK_ID_SEC_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
+&tlmm {
+	tb522fu_tdm_clk: tb522fu-tdm-clk-state {
+		pins = "gpio121";
+		function = "i2s1_sck";
+		drive-strength = <8>;
+		bias-disable;
+	};
+	tb522fu_tdm_ws: tb522fu-tdm-ws-state {
+		pins = "gpio123";
+		function = "i2s1_ws";
+		drive-strength = <8>;
+		bias-disable;
+	};
+	tb522fu_tdm_data: tb522fu-tdm-data-state {
+		pins = "gpio124";
+		function = "i2s1_data1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	tb522fu_amp0: amplifier@34 {
+		compatible = "awinic,aw88461";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <0>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr0";
+	};
+
+	tb522fu_amp2: amplifier@35 {
+		compatible = "awinic,aw88461";
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <2>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr2";
+	};
+
+	tb522fu_amp4: amplifier@36 {
+		compatible = "awinic,aw88461";
+		reg = <0x36>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <4>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr4";
+	};
+};
+
+&i2c6 {
+	status = "okay";
+
+	tb522fu_amp5: amplifier@34 {
+		compatible = "awinic,aw88461";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <5>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr5";
+	};
+
+	tb522fu_amp1: amplifier@35 {
+		compatible = "awinic,aw88461";
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <1>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr1";
+	};
+
+	tb522fu_amp3: amplifier@36 {
+		compatible = "awinic,aw88461";
+		reg = <0x36>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		awinic,audio-channel = <3>;
+		/* At least 24 dB below stock tuning until DSP protection exists. */
+		awinic,maximum-volume = <767>;
+		firmware-name = "qcom/sm8750/lenovo/tb522fu/aw88461_acf.bin";
+		sound-name-prefix = "Spkr3";
+	};
+};
diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 4d48e1012cd4..3d7e86ab0630 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -81,6 +81,7 @@ struct sc8280xp_snd_data {
 	struct snd_soc_jack dp_jack[8];
 	const struct qcom_snd_soc_common *priv;
 	bool jack_setup;
+	bool tb522fu;
 };
 
 static inline int sc8280xp_get_mclk_freq(struct snd_pcm_hw_params *params)
@@ -116,6 +117,7 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	struct qcom_snd_tdm_slot_cfg cpu_cfg;
 	struct qcom_snd_tdm_slot_cfg codec_cfg;
 	int bclk_freq;
+	unsigned int codec_fmt = data->priv->codec_dai_fmt;
 	int ret;
 	int i;
 
@@ -130,10 +132,13 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	if (ret && ret != -ENOTSUPP)
 		return ret;
 
-	if (data->priv->codec_dai_fmt) {
+	if (data->tb522fu)
+		codec_fmt = SND_SOC_DAIFMT_DSP_B | SND_SOC_DAIFMT_NB_NF |
+			    SND_SOC_DAIFMT_BC_FC;
+	if (codec_fmt) {
 		for_each_rtd_codec_dais(rtd, i, codec_dai) {
 			ret = snd_soc_dai_set_fmt(codec_dai,
-						  data->priv->codec_dai_fmt);
+						  codec_fmt);
 			if (ret && ret != -ENOTSUPP)
 				return ret;
 		}
@@ -147,7 +152,7 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	if (bclk_freq <= 0)
 		return -EINVAL;
 
-	if (data->priv->mi2s_bclk_enable) {
+	if (data->priv->mi2s_bclk_enable || data->tb522fu) {
 		ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_MI2S_BCLK, bclk_freq,
 					     SND_SOC_CLOCK_IN);
 		if (ret && ret != -ENOTSUPP) {
@@ -209,7 +214,7 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 	if (dp_jack)
 		return qcom_snd_dp_jack_setup(rtd, dp_jack, dp_pcm_id);
 
-	if (data->priv->wcd_jack)
+	if (data->priv->wcd_jack && !data->tb522fu)
 		return qcom_snd_wcd_jack_setup(rtd, &data->jack, &data->jack_setup);
 
 	return 0;
@@ -218,6 +223,7 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_interval *rate = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_RATE);
@@ -226,6 +232,13 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
 	rate->min = rate->max = 48000;
+	if (data->tb522fu && cpu_dai->id == SECONDARY_TDM_RX_0) {
+		/* Stock ACDB and the six amplifier profiles use eight 32-bit slots. */
+		channels->min = channels->max = 8;
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
+		return 0;
+	}
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 	channels->min = 2;
 	channels->max = 2;
@@ -424,6 +437,8 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	ret = qcom_snd_parse_of(card);
 	if (ret)
 		return ret;
+	/* ABL rewrites the root compatible; the sound card name is preserved. */
+	data->tb522fu = !strcmp(card->name, "TB522FU");
 
 	card->driver_name = data->priv->driver_name;
 	sc8280xp_add_be_ops(card);
-- 
2.47.3

