Subject: [PATCH] input: describe the Lenovo touchpad as a single-button clickpad

Physical corner clicks report BTN_LEFT. GNOME supplies secondary clicks
using its configured two-finger method. Advertising BTN_RIGHT as well as
INPUT_PROP_BUTTONPAD causes a libinput warning and misstates the hardware.
Remove that extra capability and its reports; keep all coordinates/gestures.

--- a/drivers/input/misc/lenovo-yoga-keyboard.c
+++ b/drivers/input/misc/lenovo-yoga-keyboard.c
@@ -114,7 +114,6 @@
 		input_mt_report_slot_state(kb->touchpad, MT_TOOL_FINGER, false);
 	}
 	input_report_key(kb->touchpad, BTN_LEFT, 0);
-	input_report_key(kb->touchpad, BTN_RIGHT, 0);
 	input_mt_sync_frame(kb->touchpad);
 	input_sync(kb->touchpad);
 }
@@ -174,7 +173,6 @@
 		}
 	}
 	input_report_key(kb->touchpad, BTN_LEFT, data[2] & BIT(0));
-	input_report_key(kb->touchpad, BTN_RIGHT, data[2] & BIT(1));
 	input_mt_sync_frame(kb->touchpad);
 	input_sync(kb->touchpad);
 	kb->touch_reports++;
@@ -438,8 +436,8 @@
 			input_set_capability(kb->keyboard, EV_KEY, ly_keymap[i]);
 	for (i = 0; i < ARRAY_SIZE(ly_consumer_map); i++)
 		input_set_capability(kb->keyboard, EV_KEY, ly_consumer_map[i].key);
+	/* One physical click switch; libinput implements secondary clicks. */
 	input_set_capability(kb->touchpad, EV_KEY, BTN_LEFT);
-	input_set_capability(kb->touchpad, EV_KEY, BTN_RIGHT);
 	input_set_abs_params(kb->touchpad, ABS_MT_POSITION_X, 0, LY_TOUCH_X_MAX, 0, 0);
 	input_set_abs_params(kb->touchpad, ABS_MT_POSITION_Y, 0, LY_TOUCH_Y_MAX, 0, 0);
 	input_set_abs_params(kb->touchpad, ABS_MT_TOOL_TYPE, 0, MT_TOOL_PALM, 0, 0);
