 }
 EXPORT_SYMBOL_GPL(qcom_scm_io_writel);
+
+/* Temporary, opt-in bring-up return path. The address comes from this board's
+ * stock DT. EDL=1 and OEM warm reset match its stock SCM driver; the complete
+ * sequence was exercised in a standalone normal-boot payload before Linux.
+ * This is deliberately not the ordinary Qualcomm crash-dump download mode.
+ */
+static bool tb522fu_probe_scm_available(u32 function)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_INFO,
+		.cmd = QCOM_SCM_INFO_IS_CALL_AVAIL,
+		.arginfo = QCOM_SCM_ARGS(1),
+		.args[0] = function,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	ret = qcom_scm_call_atomic(__scm->dev, &desc, &res);
+	return !ret && res.result[0] == 1;
+}
+
+static int tb522fu_probe_restart(struct notifier_block *nb,
+				unsigned long action, void *data)
+{
+	struct qcom_scm_desc sdi = {
+		.svc = QCOM_SCM_SVC_BOOT,
+		.cmd = QCOM_SCM_BOOT_SDI_CONFIG,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = 1,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_desc reset = {
+		.svc = 0x09,
+		.cmd = 0x22,
+		.owner = ARM_SMCCC_OWNER_OEM,
+	};
+	u32 old, actual;
+	int ret;
+
+	ret = qcom_scm_io_readl(__scm->dload_mode_addr, &old);
+	if (ret || old) {
+		pr_emerg("TB522FU_EDL_RETURN: download cookie unavailable or not normal\n");
+		return NOTIFY_STOP;
+	}
+	ret = qcom_scm_io_writel(__scm->dload_mode_addr, 1);
+	if (ret)
+		goto rollback;
+	ret = qcom_scm_io_readl(__scm->dload_mode_addr, &actual);
+	if (ret || actual != 1)
+		goto rollback;
+	/* Restart handlers run atomically: no clocks, allocation or sleeping SCM. */
+	ret = qcom_scm_call_atomic(__scm->dev, &sdi, NULL);
+	if (ret)
+		goto rollback;
+	qcom_scm_call_atomic(__scm->dev, &reset, NULL);
+rollback:
+	/* A failed write may have taken effect. Do not fall through to a cold
+	 * reset, which would repeatedly boot the temporary image in boot_b.
+	 */
+	ret = qcom_scm_io_writel(__scm->dload_mode_addr, old);
+	if (ret || qcom_scm_io_readl(__scm->dload_mode_addr, &actual) || actual != old)
+		pr_emerg("TB522FU_EDL_RETURN: cookie rollback failed\n");
+	pr_emerg("TB522FU_EDL_RETURN: firmware reset failed; physical EDL recovery required\n");
+	return NOTIFY_STOP;
+}
+
+static struct notifier_block tb522fu_probe_restart_nb = {
+	.notifier_call = tb522fu_probe_restart,
+	.priority = 255,
+};
+
+static void tb522fu_probe_timeout(struct timer_list *timer)
+{
+	pr_emerg("TB522FU_PROBE_TIMEOUT: 180-second kernel timer, returning to EDL\n");
+	emergency_restart();
+}
+
+static DEFINE_TIMER(tb522fu_probe_timer, tb522fu_probe_timeout);
+
+static void tb522fu_probe_arm_return(struct qcom_scm *scm)
+{
+	static const u32 services[] = {
+		0x02000501, 0x02000502, 0x02000109, 0x03000922,
+	};
+	u32 cookie;
+	int i, ret;
+
+	if (!tb522fu_probe_edl_return)
+		return;
+	if (!of_machine_is_compatible("lenovo,y900") ||
+	    scm->dload_mode_addr != 0x1fd9000 ||
+	    __get_convention() != SMC_CONVENTION_ARM_64)
+		goto unavailable;
+	for (i = 0; i < ARRAY_SIZE(services); i++)
+		if (!tb522fu_probe_scm_available(services[i]))
+			goto unavailable;
+	if (qcom_scm_io_readl(scm->dload_mode_addr, &cookie) || cookie)
+		goto unavailable;
+	ret = register_restart_handler(&tb522fu_probe_restart_nb);
+	if (ret)
+		goto unavailable;
+	tb522fu_probe_edl_ready = true;
+	mod_timer(&tb522fu_probe_timer, jiffies + 180 * HZ);
+	dev_info(scm->dev, "TB522FU_EDL_RETURN_ARMED: restart handler and 180-second kernel timer\n");
+	return;
+unavailable:
+	dev_err(scm->dev, "TB522FU_EDL_RETURN_UNAVAILABLE: init must power off, not reboot\n");
+}
 
