+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OmniVision OV02B10, 24 MHz, one-lane 1600x1200 RAW10.
+ * Register sequence and controls derived from Rockchip's GPL OV02B10 driver.
+ * Timing units and stream gating cross-checked with the MediaTek GPL driver.
+ * Copyright (C) 2020 Rockchip Electronics Co., Ltd.
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define OV02B10_WIDTH		1600
+#define OV02B10_HEIGHT		1200
+#define OV02B10_XCLK		24000000
+#define OV02B10_LINK_FREQ	330000000LL
+#define OV02B10_PIXEL_RATE	66000000
+/* One internal timing clock accounts for four output pixels. */
+#define OV02B10_HTS		(448 * 4)
+#define OV02B10_BASE_LINES	1220
+#define OV02B10_VTS_MIN		1222
+#define OV02B10_VTS_MAX		(OV02B10_BASE_LINES + 0x7ffe)
+#define OV02B10_EXPOSURE_MARGIN	7
+#define OV02B10_PAGE		0xfd
+#define OV02B10_LATCH		0xfe
+
+struct ov02b10_reg {
+	u8 reg;
+	u8 val;
+};
+
+struct ov02b10 {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+	struct clk *xclk;
+	struct gpio_desc *reset;
+	struct regulator_bulk_data supplies[2];
+};
+
+/* Public 24-MHz mode, with MIPI disabled until enable_streams(). */
+static const struct ov02b10_reg ov02b10_mode_regs[] = {
+	{ 0xfc, 0x01 },
+	{ 0xfd, 0x00 },
+	{ 0xfd, 0x00 },
+	{ 0x24, 0x02 },
+	{ 0x25, 0x06 },
+	{ 0x29, 0x03 },
+	{ 0x2a, 0x34 },
+	{ 0x1e, 0x17 },
+	{ 0x33, 0x07 },
+	{ 0x35, 0x07 },
+	{ 0x4a, 0x0c },
+	{ 0x3a, 0x05 },
+	{ 0x3b, 0x02 },
+	{ 0x3e, 0x00 },
+	{ 0x46, 0x01 },
+	{ 0x6d, 0x03 },
+	{ 0xfd, 0x01 },
+	{ 0x0e, 0x02 },
+	{ 0x0f, 0x1a },
+	{ 0x18, 0x00 },
+	{ 0x22, 0xff },
+	{ 0x23, 0x02 },
+	{ 0x17, 0x2c },
+	{ 0x19, 0x20 },
+	{ 0x1b, 0x06 },
+	{ 0x1c, 0x04 },
+	{ 0x20, 0x03 },
+	{ 0x30, 0x01 },
+	{ 0x33, 0x01 },
+	{ 0x31, 0x0a },
+	{ 0x32, 0x09 },
+	{ 0x38, 0x01 },
+	{ 0x39, 0x01 },
+	{ 0x3a, 0x01 },
+	{ 0x3b, 0x01 },
+	{ 0x4f, 0x04 },
+	{ 0x4e, 0x05 },
+	{ 0x50, 0x01 },
+	{ 0x35, 0x0c },
+	{ 0x45, 0x2a },
+	{ 0x46, 0x2a },
+	{ 0x47, 0x2a },
+	{ 0x48, 0x2a },
+	{ 0x4a, 0x2c },
+	{ 0x4b, 0x2c },
+	{ 0x4c, 0x2c },
+	{ 0x4d, 0x2c },
+	{ 0x56, 0x3a },
+	{ 0x57, 0x0a },
+	{ 0x58, 0x24 },
+	{ 0x59, 0x20 },
+	{ 0x5a, 0x0a },
+	{ 0x5b, 0xff },
+	{ 0x37, 0x0a },
+	{ 0x42, 0x0e },
+	{ 0x68, 0x90 },
+	{ 0x69, 0xcd },
+	{ 0x6a, 0x8f },
+	{ 0x7c, 0x0a },
+	{ 0x7d, 0x0a },
+	{ 0x7e, 0x0a },
+	{ 0x7f, 0x08 },
+	{ 0x83, 0x14 },
+	{ 0x84, 0x14 },
+	{ 0x86, 0x14 },
+	{ 0x87, 0x07 },
+	{ 0x88, 0x0f },
+	{ 0x94, 0x02 },
+	{ 0x98, 0xd1 },
+	{ 0xfe, 0x02 },
+	{ 0xfd, 0x03 },
+	{ 0x97, 0x6c },
+	{ 0x98, 0x60 },
+	{ 0x99, 0x60 },
+	{ 0x9a, 0x6c },
+	{ 0xa1, 0x40 },
+	{ 0xaf, 0x04 },
+	{ 0xb1, 0x40 },
+	{ 0xae, 0x0d },
+	{ 0x88, 0x5b },
+	{ 0x89, 0x7c },
+	{ 0xb4, 0x05 },
+	{ 0x8c, 0x40 },
+	{ 0x8e, 0x40 },
+	{ 0x90, 0x40 },
+	{ 0x92, 0x40 },
+	{ 0x9b, 0x46 },
+	{ 0xac, 0x40 },
+	{ 0xfd, 0x00 },
+	{ 0x5a, 0x15 },
+	{ 0x74, 0x01 },
+	{ 0xfd, 0x00 },
+	{ 0x50, 0x40 },
+	{ 0x52, 0xb0 },
+	{ 0xfd, 0x01 },
+	{ 0x03, 0x70 },
+	{ 0x05, 0x10 },
+	{ 0x07, 0x20 },
+	{ 0x09, 0xb0 },
+	{ 0xfd, 0x03 },
+	{ 0xc2, 0x00 },
+	{ 0xfb, 0x01 },
+};
+
+static const s64 ov02b10_link_freqs[] = { OV02B10_LINK_FREQ };
+static const u32 ov02b10_codes[] = {
+	MEDIA_BUS_FMT_SBGGR10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10,
+	MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+};
+
+static inline struct ov02b10 *to_ov02b10(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov02b10, sd);
+}
+
+static void ov02b10_write(struct ov02b10 *sensor, u8 reg, u8 val, int *error)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+
+	if (!*error)
+		*error = i2c_smbus_write_byte_data(client, reg, val);
+}
+
+static u32 ov02b10_code(struct ov02b10 *sensor)
+{
+	return ov02b10_codes[sensor->hflip->val | (sensor->vflip->val << 1)];
+}
+
+static int ov02b10_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov02b10 *sensor = container_of(ctrl->handler, struct ov02b10, ctrls);
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	struct v4l2_subdev_state *state;
+	u32 val;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		val = OV02B10_HEIGHT + ctrl->val - OV02B10_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(sensor->exposure, 4, val, 1,
+					 min_t(u32, sensor->exposure->default_value, val));
+	}
+
+	ret = pm_runtime_get_if_in_use(&client->dev);
+	if (ret < 0)
+		return ret;
+	if (!ret)
+		goto update_format;
+	ret = 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ov02b10_write(sensor, OV02B10_PAGE, 1, &ret);
+		ov02b10_write(sensor, 0x0e, ctrl->val >> 8, &ret);
+		ov02b10_write(sensor, 0x0f, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ov02b10_write(sensor, OV02B10_PAGE, 1, &ret);
+		ov02b10_write(sensor, 0x22, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ov02b10_write(sensor, OV02B10_PAGE, 3, &ret);
+		ov02b10_write(sensor, 0x9b, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		val = OV02B10_HEIGHT + ctrl->val - OV02B10_BASE_LINES;
+		ov02b10_write(sensor, OV02B10_PAGE, 1, &ret);
+		ov02b10_write(sensor, 0x14, val >> 8, &ret);
+		ov02b10_write(sensor, 0x15, val, &ret);
+		/* The horizontal timing registers use internal clock units. */
+		ov02b10_write(sensor, 0x25, (OV02B10_HTS / 4) >> 8, &ret);
+		ov02b10_write(sensor, 0x26, (OV02B10_HTS / 4) & 0xff, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ov02b10_write(sensor, OV02B10_PAGE, 1, &ret);
+		ov02b10_write(sensor, 0x12, sensor->hflip->val |
+			      (sensor->vflip->val << 1), &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	ov02b10_write(sensor, OV02B10_LATCH, 2, &ret);
+	pm_runtime_put(&client->dev);
+update_format:
+	if (!ret && (ctrl->id == V4L2_CID_HFLIP || ctrl->id == V4L2_CID_VFLIP)) {
+		state = v4l2_subdev_get_locked_active_state(&sensor->sd);
+		if (state)
+			v4l2_subdev_state_get_format(state, 0)->code = ov02b10_code(sensor);
+	}
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov02b10_ctrl_ops = {
+	.s_ctrl = ov02b10_set_ctrl,
+};
+
+static int ov02b10_init_controls(struct ov02b10 *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(&sensor->ctrls, 10);
+	ctrl = v4l2_ctrl_new_int_menu(&sensor->ctrls, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(ov02b10_link_freqs) - 1, 0, ov02b10_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(&sensor->ctrls, NULL, V4L2_CID_PIXEL_RATE,
+			  OV02B10_PIXEL_RATE, OV02B10_PIXEL_RATE, 1, OV02B10_PIXEL_RATE);
+	ctrl = v4l2_ctrl_new_std(&sensor->ctrls, NULL, V4L2_CID_HBLANK,
+				 OV02B10_HTS - OV02B10_WIDTH, OV02B10_HTS - OV02B10_WIDTH,
+				 1, OV02B10_HTS - OV02B10_WIDTH);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops, V4L2_CID_VBLANK,
+			  OV02B10_VTS_MIN - OV02B10_HEIGHT, OV02B10_VTS_MAX - OV02B10_HEIGHT,
+			  2, OV02B10_VTS_MIN - OV02B10_HEIGHT);
+	sensor->exposure = v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops,
+					     V4L2_CID_EXPOSURE, 4,
+					     OV02B10_VTS_MIN - OV02B10_EXPOSURE_MARGIN,
+					     1, 0x21a);
+	v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  0x10, 0xf8, 1, 0x10);
+	v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  0x40, 0xff, 1, 0x40);
+	sensor->hflip = v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	sensor->vflip = v4l2_ctrl_new_std(&sensor->ctrls, &ov02b10_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (sensor->ctrls.error) {
+		ret = sensor->ctrls.error;
+		goto error;
+	}
+	sensor->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	sensor->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error;
+	ret = v4l2_ctrl_new_fwnode_properties(&sensor->ctrls, NULL, &props);
+	if (ret)
+		goto error;
+	sensor->sd.ctrl_handler = &sensor->ctrls;
+	return 0;
+error:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	return ret;
+}
+
+static int ov02b10_set_format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *format)
+{
+	struct ov02b10 *sensor = to_ov02b10(sd);
+
+	if (format->pad)
+		return -EINVAL;
+	format->format = (struct v4l2_mbus_framefmt) {
+		.width = OV02B10_WIDTH,
+		.height = OV02B10_HEIGHT,
+		.code = ov02b10_code(sensor),
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+	*v4l2_subdev_state_get_format(state, 0) = format->format;
+	return 0;
+}
+
+static int ov02b10_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = { .which = V4L2_SUBDEV_FORMAT_TRY };
+
+	return ov02b10_set_format(sd, state, &fmt);
+}
+
+static int ov02b10_enum_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad || code->index)
+		return -EINVAL;
+	code->code = ov02b10_code(to_ov02b10(sd));
+	return 0;
+}
+
+static int ov02b10_enum_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_frame_size_enum *size)
+{
+	if (size->pad || size->index || size->code != ov02b10_code(to_ov02b10(sd)))
+		return -EINVAL;
+	size->min_width = OV02B10_WIDTH;
+	size->max_width = OV02B10_WIDTH;
+	size->min_height = OV02B10_HEIGHT;
+	size->max_height = OV02B10_HEIGHT;
+	return 0;
+}
+
+static int ov02b10_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	if (sel->pad)
+		return -EINVAL;
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = (struct v4l2_rect) { 0, 0, OV02B10_WIDTH, OV02B10_HEIGHT };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int ov02b10_stream_gate(struct ov02b10 *sensor, bool on)
+{
+	int ret = 0;
+
+	ov02b10_write(sensor, OV02B10_PAGE, 3, &ret);
+	ov02b10_write(sensor, 0xc2, on, &ret);
+	ov02b10_write(sensor, OV02B10_PAGE, 1, &ret);
+	return ret;
+}
+
+static int ov02b10_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct ov02b10 *sensor = to_ov02b10(sd);
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	int i, ret;
+
+	ret = pm_runtime_resume_and_get(&client->dev);
+	if (ret < 0)
+		return ret;
+	ret = 0;
+	for (i = 0; i < ARRAY_SIZE(ov02b10_mode_regs) && !ret; i++) {
+		ov02b10_write(sensor, ov02b10_mode_regs[i].reg, ov02b10_mode_regs[i].val,
+			      &ret);
+		if (ov02b10_mode_regs[i].reg == 0xfc)
+			usleep_range(5000, 6000);
+	}
+	if (ret)
+		goto error;
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret)
+		goto error;
+	ret = ov02b10_stream_gate(sensor, true);
+	if (ret)
+		goto error;
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	__v4l2_ctrl_grab(sensor->vflip, true);
+	return 0;
+error:
+	ov02b10_stream_gate(sensor, false);
+	pm_runtime_put_sync(&client->dev);
+	return ret;
+}
+
+static int ov02b10_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				   u32 pad, u64 streams_mask)
+{
+	struct ov02b10 *sensor = to_ov02b10(sd);
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	int ret = ov02b10_stream_gate(sensor, false);
+
+	/* Vendor driver allows two frames to drain after disabling MIPI. */
+	msleep(70);
+	__v4l2_ctrl_grab(sensor->hflip, false);
+	__v4l2_ctrl_grab(sensor->vflip, false);
+	pm_runtime_put_sync(&client->dev);
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops ov02b10_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov02b10_pad_ops = {
+	.enum_mbus_code = ov02b10_enum_code,
+	.enum_frame_size = ov02b10_enum_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ov02b10_set_format,
+	.get_selection = ov02b10_get_selection,
+	.enable_streams = ov02b10_enable_streams,
+	.disable_streams = ov02b10_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov02b10_ops = {
+	.video = &ov02b10_video_ops,
+	.pad = &ov02b10_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov02b10_internal_ops = {
+	.init_state = ov02b10_init_state,
+};
+
+static const struct media_entity_operations ov02b10_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int ov02b10_power_on(struct device *dev)
+{
+	struct ov02b10 *sensor = to_ov02b10(dev_get_drvdata(dev));
+	int ret;
+
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	ret = regulator_enable(sensor->supplies[0].consumer);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1500);
+	ret = regulator_enable(sensor->supplies[1].consumer);
+	if (ret)
+		goto disable_io;
+	usleep_range(7000, 8000);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	usleep_range(9000, 10000);
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret)
+		goto assert_reset;
+	usleep_range(5000, 6000);
+	return 0;
+
+assert_reset:
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	regulator_disable(sensor->supplies[1].consumer);
+disable_io:
+	regulator_disable(sensor->supplies[0].consumer);
+	return ret;
+}
+
+static int ov02b10_power_off(struct device *dev)
+{
+	struct ov02b10 *sensor = to_ov02b10(dev_get_drvdata(dev));
+
+	clk_disable_unprepare(sensor->xclk);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 1500);
+	regulator_disable(sensor->supplies[1].consumer);
+	usleep_range(2000, 2500);
+	regulator_disable(sensor->supplies[0].consumer);
+	usleep_range(1000, 1500);
+	return 0;
+}
+
+static int ov02b10_check_endpoint(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	unsigned int i;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return -EINVAL;
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (ep.bus.mipi_csi2.num_data_lanes != 1 || ep.bus.mipi_csi2.clock_lane != 0 ||
+	    ep.bus.mipi_csi2.data_lanes[0] != 1 ||
+	    ep.bus.mipi_csi2.lane_polarities[0] || ep.bus.mipi_csi2.lane_polarities[1])
+		goto done;
+	for (i = 0; i < ep.nr_of_link_frequencies; i++)
+		if (ep.link_frequencies[i] == OV02B10_LINK_FREQ)
+			ret = 0;
+done:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ov02b10_identify(struct ov02b10 *sensor)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sensor->sd);
+	int ret, hi, lo;
+
+	ret = i2c_smbus_write_byte_data(client, OV02B10_PAGE, 0);
+	if (ret)
+		return ret;
+	hi = i2c_smbus_read_byte_data(client, 0x02);
+	if (hi < 0)
+		return hi;
+	lo = i2c_smbus_read_byte_data(client, 0x03);
+	if (lo < 0)
+		return lo;
+	if (((hi << 8) | lo) != 0x002b)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "Unexpected chip ID %04x\n", (hi << 8) | lo);
+	dev_info(&client->dev, "Detected OV02B10 (002b)\n");
+	return 0;
+}
+
+static int ov02b10_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov02b10 *sensor;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+
+	ret = ov02b10_check_endpoint(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "Requires one lane and 330 MHz link frequency\n");
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	v4l2_i2c_subdev_init(&sensor->sd, client, &ov02b10_ops);
+	sensor->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->xclk), "Cannot get sensor clock\n");
+	if (clk_get_rate(sensor->xclk) != OV02B10_XCLK)
+		return dev_err_probe(dev, -EINVAL, "Only 24 MHz sensor clock supported\n");
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset), "Cannot get reset GPIO\n");
+	sensor->supplies[0].supply = "dovdd";
+	sensor->supplies[1].supply = "avdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Cannot get supplies\n");
+	ret = ov02b10_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "Cannot power sensor\n");
+	ret = ov02b10_identify(sensor);
+	if (ret)
+		goto power_off;
+	ret = ov02b10_init_controls(sensor);
+	if (ret)
+		goto power_off;
+	sensor->sd.internal_ops = &ov02b10_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->sd.entity.ops = &ov02b10_entity_ops;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto free_controls;
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto clean_entity;
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto clean_subdev;
+	pm_runtime_idle(dev);
+	return 0;
+
+clean_subdev:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+clean_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+power_off:
+	ov02b10_power_off(dev);
+	return ret;
+}
+
+static void ov02b10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov02b10 *sensor = to_ov02b10(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		ov02b10_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov02b10_pm_ops, ov02b10_power_off,
+				 ov02b10_power_on, NULL);
+static const struct of_device_id ov02b10_of_match[] = {
+	{ .compatible = "ovti,ov02b10" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov02b10_of_match);
+
+static struct i2c_driver ov02b10_driver = {
+	.driver = {
+		.name = "ov02b10",
+		.of_match_table = ov02b10_of_match,
+		.pm = pm_ptr(&ov02b10_pm_ops),
+	},
+	.probe = ov02b10_probe,
+	.remove = ov02b10_remove,
+};
+module_i2c_driver(ov02b10_driver);
+MODULE_DESCRIPTION("OmniVision OV02B10 camera sensor");
+MODULE_LICENSE("GPL");
