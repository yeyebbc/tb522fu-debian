Subject: [PATCH] arm64: dts: qcom: tb522fu: stage PCIe Wi-Fi

Stock CNSS wiring and active supply ranges are used for this board.
Keep the normal IOMMU map; the separate upstream PCI driver fix parses it.
The PCIe PHY supply association remains a bounded hardware-test candidate.

---
--- a/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-y900-acm.dts
@@ -608,3 +608,123 @@
 		gpr { status = "disabled"; };
 	};
 };
+
+/* PCIe Wi-Fi: Lenovo stock CNSS peach supplies and WLAN_EN wiring. */
+&apps_rsc {
+	regulators-d {
+		vdd-s4-supply = <&vph_pwr>;
+		vreg_s4d_wlan: smps4 {
+			regulator-name = "vreg_s4d_wlan";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1036000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+	regulators-f {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "f";
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-l1-supply = <&vreg_s1d>;
+		vdd-l2-supply = <&vreg_s7i>;
+		vdd-l3-supply = <&vreg_s3g>;
+		vreg_s5f_wlan: smps5 {
+			regulator-name = "vreg_s5f_wlan";
+			regulator-min-microvolt = <876000>;
+			regulator-max-microvolt = <1000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+		vreg_l1f: ldo1 {
+			regulator-name = "vreg_l1f_refgen";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+		vreg_l2f: ldo2 {
+			regulator-name = "vreg_l2f_wlan_io12";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+		vreg_l3f: ldo3 {
+			regulator-name = "vreg_l3f_wlan_io";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+/* Match the stock CNSS active RF votes; maxima stay unchanged. */
+&vreg_s3g { regulator-min-microvolt = <1860000>; };
+&vreg_s7i { regulator-min-microvolt = <1312000>; };
+
+/ {
+	wcn7860-pmu {
+		compatible = "qcom,wcn7860-pmu";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en_default>;
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		vddio-supply = <&vreg_l3f>;
+		vddio1p2-supply = <&vreg_l2f>;
+		vddaon-supply = <&vreg_s4d_wlan>;
+		vdddig-supply = <&vreg_s5f_wlan>;
+		vddrfa1p2-supply = <&vreg_s7i>;
+		vddrfa1p8-supply = <&vreg_s3g>;
+		regulators {
+			wlan_pmu_rfacmn: ldo0 { regulator-name = "wlan_pmu_rfacmn"; };
+			wlan_pmu_aon: ldo1 { regulator-name = "wlan_pmu_aon"; };
+			wlan_pmu_wlcx: ldo2 { regulator-name = "wlan_pmu_wlcx"; };
+			wlan_pmu_wlmx: ldo3 { regulator-name = "wlan_pmu_wlmx"; };
+			wlan_pmu_btcmx: ldo4 { regulator-name = "wlan_pmu_btcmx"; };
+			wlan_pmu_rfa0p8: ldo5 { regulator-name = "wlan_pmu_rfa0p8"; };
+			wlan_pmu_rfa1p2: ldo6 { regulator-name = "wlan_pmu_rfa1p2"; };
+			wlan_pmu_rfa1p8: ldo7 { regulator-name = "wlan_pmu_rfa1p8"; };
+			wlan_pmu_pcie0p9: ldo8 { regulator-name = "wlan_pmu_pcie0p9"; };
+			wlan_pmu_pcie1p8: ldo9 { regulator-name = "wlan_pmu_pcie1p8"; };
+		};
+	};
+};
+
+&tlmm {
+	wlan_en_default: wlan-en-default-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+		/* The power sequencer owns the output level. */
+	};
+};
+
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_default_state>;
+	status = "okay";
+};
+
+&pcie0_phy {
+	/* Shared refgen/PLL rails: stock L1F 0.88 V and L3G 1.2 V.
+	 * The PCIe association follows the working SM8750 community tree;
+	 * stock exposes only the PHY GDSC, so link training must verify it.
+	 */
+	vdda-phy-supply = <&vreg_l1f>;
+	vdda-pll-supply = <&vreg_l3g>;
+	status = "okay";
+};
+
+&pcieport0 {
+	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
+	wifi@0 {
+		compatible = "pci17cb,110e";
+		reg = <0x10000 0 0 0 0>;
+		vddrfacmn-supply = <&wlan_pmu_rfacmn>;
+		vddaon-supply = <&wlan_pmu_aon>;
+		vddwlcx-supply = <&wlan_pmu_wlcx>;
+		vddwlmx-supply = <&wlan_pmu_wlmx>;
+		vddrfa0p8-supply = <&wlan_pmu_rfa0p8>;
+		vddrfa1p2-supply = <&wlan_pmu_rfa1p2>;
+		vddrfa1p8-supply = <&wlan_pmu_rfa1p8>;
+		vddpcie0p9-supply = <&wlan_pmu_pcie0p9>;
+		vddpcie1p8-supply = <&wlan_pmu_pcie1p8>;
+	};
+};
